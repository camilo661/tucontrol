<?xml version="1.0" encoding="utf-8"?>
<!--
    Smart TVs expose their control APIs over plain HTTP / WS on the local network.
    Cleartext is therefore allowed; TLS connections to TVs use their self-signed certs.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
